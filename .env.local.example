# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...     # requerido para el webhook de MP

# === App ===
NEXT_PUBLIC_APP_URL=https://narvoq.com   # (o http://localhost:3000 en dev)

# === Mercado Pago (suscripciones NarvoQ - lo que ya tenías) ===
MP_ACCESS_TOKEN=APP_USR-...              # token de tu cuenta NarvoQ

# === Mercado Pago MARKETPLACE (nuevo — para pagos jugador→club) ===
# Los sacás del panel MP Developers → tu App → Credenciales
# https://www.mercadopago.com.ar/developers/panel/app
MP_APP_ID=1234567890123456               # Client ID de la app
MP_CLIENT_SECRET=abc...def               # Client Secret de la app

# En el mismo panel MP configurá:
#   URLs de redirección → https://narvoq.com/api/mp/oauth/callback
#   Notificaciones webhook → https://narvoq.com/api/mp/webhook-booking
